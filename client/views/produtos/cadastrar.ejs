<%- include('../partials/header.ejs')%>

<main class="flex-grow-1">
  <h1 class="text-center my-3">Estou na Pagina de cadastro de Produto</h1>
  <div class="container">
    <!-- cria formulario -->

    <form action="/produtos/cadastrar" method="post">
      <!-- Caixinha Codigo interno-->
      <div>
        <label class="codigo_interno m-5"> Codigo interno </label>
        <input
          type="text"
          id="codigo_interno"
          name="codigo_interno"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha Nome-->
      <div>
        <label class="nome m-5"> Nome</label>
        <input
          type="text"
          id="nome"
          name="nome"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha Categoria -->
      <div>
        <label class="categoria m-5"> Categoria </label>
        <select name="categoria" id="categoria" class="form-control" required>
          <option value="legume">legume</option>
          <option value="fruta">Fruta</option>
          <option value="carne">Carne</option>
        </select>
      </div>
      <!-- Caixinha Unidade venda-->
      <div>
        <label class="unidade_venda m-5"> Unidade Venda</label>
        <select
          name="unidade_venda"
          id="unidade_venda"
          class="form-control"
          required
        >
          <option value="L">Litro</option>
          <option value="Kg">Kilo grama</option>
          <option value="unidade">Unidade</option>
        </select>
      </div>
      <!-- Caixinha preco -->
      <div>
        <label class="preco m-5"> preço </label>
        <input
          type="number"
          id="preco"
          name="preco"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha  imagem-->
      <div>
        <label class="imagem m-5"> Imagem </label>
        <input
          type="text"
          id="imagem"
          name="imagem"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha  publico_bool-->
      <div>
        <label class="esta_ativo m-5"> Ativo ou não ativo</label>
        <select name="esta_ativo" id="esta_ativo">
          <option value="1">Ativo</option>
          <option value="0">Desativado</option>
        </select>
      </div>
      <div class="d-grid mt-5">
        <button
          type="submit"
          class="btn btn-outline theme-success full-width-btn mt-15"
        >
          Cadastrar produto
        </button>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer.ejs')%>
