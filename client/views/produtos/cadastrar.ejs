<%- include('../partials/header.ejs')%>

<main class="flex-grow-1 ">
  <div class="container">
    <!-- cria formulario -->

    <form action="/produtos/cadastrar" method="post">
      <!-- Caixinha Codigo interno-->
      <div>
        <label class="codigo_interno"> Codigo interno </label>
        <input
          type="text"
          id="codigo_interno"
          name="codigo_interno"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha Nome-->
      <div>
        <label class="nome"> Nome</label>
        <input
          type="text"
          id="nome"
          name="nome"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha Categoria -->
      <div>
        <label class="categoria"> Categoria </label>
        <select name="categoria" id="categoria" class="form-control" required>
          <option value="legume">legume</option>
          <option value="fruta">Fruta</option>
          <option value="carne">Carne</option>
        </select>
      </div>
      <!-- Caixinha Unidade venda-->
      <div>
        <label class="unidade_venda"> Unidade Venda</label>
        <select
          name="unidade_venda"
          id="unidade_venda"
          class="form-control"
          required
        >
          <option value="L">Litro</option>
          <option value="Kg">Kilo grama</option>
          <option value="unidade">Unidade</option>
        </select>
      </div>
      <!-- Caixinha preco -->
      <div>
        <label class="preco"> preço </label>
        <input
          type="number"
          id="preco"
          name="preco"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha  imagem-->
      <div>
        <label class="imagem"> Imagem </label>
        <input
          type="text"
          id="imagem"
          name="imagem"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha  publico_bool-->
      <div>
        <label class="esta_ativo"> Ativo ou não ativo</label>
        <select name="esta_ativo" id="esta_ativo">
          <option value="1">Ativo</option>
          <option value="0">Desativado</option>
        </select>
      </div>
      <button type="submit" class="btn btn-success full-width-btn mt-15">
        Cadastrar produto
      </button>
    </form>
  </div>
</main>

<%- include('../partials/footer.ejs')%>
