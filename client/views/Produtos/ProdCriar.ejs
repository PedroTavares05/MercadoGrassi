<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Bootstrap link -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe"
      crossorigin="anonymous"
    />
    <title>Document</title>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <!-- inicio da navegação -->
    <header>
      <nav class="navbar md:navbar-expand bg-1">
        <div class="container-fluid">
          <a class="navbar-brand" href="#">Navbar</a>
          <button
            class="btn-icon navbar-toggler"
            type="button"
            data-bs-toggle="drawer"
            data-bs-target="#navbarDrawer"
            aria-controls="navbarDrawer"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
          </button>
          <dialog
            class="drawer drawer-end"
            tabindex="-1"
            id="navbarDrawer"
            aria-labelledby="navbarDrawerLabel"
          >
            <div class="drawer-header">
              <h5 class="drawer-title" id="navbarDrawerLabel">Menu</h5>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="drawer"
                aria-label="Close"
              ></button>
            </div>
            <div class="drawer-body mb-2 md:mb-0">
              <ul class="nav navbar-nav ms-auto">
                <li class="nav-item">
                  <a class="nav-link active" aria-current="page" href="#"
                    >Home</a
                  >
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="#">Link</a>
                </li>
                <li class="nav-item">
                  <button
                    class="nav-link"
                    type="button"
                    data-bs-toggle="menu"
                    aria-expanded="false"
                  >
                    Menu
                  </button>
                  <div class="menu">
                    <a class="menu-item" href="#">Action</a>
                    <a class="menu-item" href="#">Another action</a>
                    <hr class="menu-divider" />
                    <a class="menu-item" href="#">Something else here</a>
                  </div>
                </li>
              </ul>
            </div>
          </dialog>
        </div>
      </nav>
    </header>
    <!-- Fim da nevaegação -->
    <!-- Inicio da main -->
    <main
      class="container d-flex justify-content-center flex-grow-1 align-items-center"
    >
      <section class="card w-100 p-6 border border-2 border-success rounded-3">
        <h2 class="fg-success text-center">Criar novo Produto</h2>
        <div class="row row-cols-2">
          <div class="col d-flex flex-column gap-3">
            <div>
              <label for="sizesInputSmall" class="form-label"
                >Codigo Inteiro</label
              >
              <input
                class="form-control form-control"
                type="text"
                id="sizesInputSmall"
              />
            </div>
            <div>
              <label for="sizesInputDefault" class="form-label"
                >Nome Completo</label
              >
              <input class="form-control" type="text" id="sizesInputDefault" />
            </div>
            <div>
              <label for="sizesInputLarge" class="form-label">Categoria</label>
              <input
                class="form-control form-control"
                type="text"
                id="sizesInputLarge"
              />
            </div>
            <div>
              <label class="form-label">Digite um número</label>
              <input type="number" class="form-control" id="inputNumero" />
            </div>
            <div>
              <label for="inputNumero" class="form-label"
                >Digite um número</label
              >
              <input type="number" class="form-control" />
            </div>
          </div>
          <div class="col d-flex flex-column gap-3">
            <div>
              <label class="form-label">Digite o valor</label>
              <input
                class="form-control"
                type="text"
                aria-label="readonly input example"
                readonly
              />
            </div>
            <div>
              <label for="sizesSelectDefault" class="form-label"
                >Visibilidade no Sisitema</label
              >
              <select class="form-control" id="sizesSelectDefault">
                <option>Selecione um</option>
                <option value="1">valido</option>
                <option value="2">Invalido</option>
              </select>
            </div>
            <div>
              <label for="sizesInputLarge" class="form-label">Foto</label>
              <input
                class="form-control form-control"
                type="text"
                id="sizesInputLarge"
              />
            </div>
          </div>
        </div>
        <button class="btn-solid theme-primary mt-4" type="button">
          Button
        </button>
      </section>
    </main>
    <!-- fim da main -->
    <!-- Script -->
    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
