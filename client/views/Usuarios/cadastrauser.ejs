<%- include('../partials/header.ejs')%>

<main class="flex-grow-1">
  <div class="container">
    <!-- cria formulario -->

    <form action="/usuario/cadastrar" method="post">
      <!-- Caixinha Codigo nome-->
      <div>
        <label class="nome"> Nome </label>
        <input
          type="text"
          id="nome"
          name="nome"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha email-->
      <div>
        <label class="senha"> email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha Senha-->
      <div>
        <label class="senha"> Senha</label>
        <input
          type="password"
          id="senha"
          name="senha"
          class="form-control"
          required
        />
      </div>
      <!-- Caixinha Perfil-->
      <div>
        <label class="perfil"> Perfil</label>
        <select name="perfil" id="perfil">
          <option value="gestor">Gestor</option>
          <option value="operador">Operador</option>
        </select>
      </div>
      <!-- Caixinha esta ativo-->
      <div>
        <label class="perfil"> Esta ativo</label>
        <select name="perfil" id="perfil">
          <option value="ativc">Ativo</option>
          <option value="desligado">Desligado</option>
        </select>
      </div>

      <div class="d-grid mt-5">
        <button
          type="submit"
          class="btn btn-outline theme-success full-width-btn mt-15"
        >
          Cadastrar produto
        </button>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer.ejs')%>
