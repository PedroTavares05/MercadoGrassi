<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe"
      crossorigin="anonymous"
    />
    <title>Log In</title>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <!-- Cabeça -->
    <header>
      <!-- Inicio da barra de navegação -->
      <nav class="navbar" data-bs-theme="dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="#">Navbar</a>
          <button type="button" class="btn-outline theme-primary">
            Fazer Login
          </button>
        </div>
      </nav>
      <!-- Fim da barra de  navegação -->
    </header>
    <!-- Corpo -->
    <main
      class="container d-flex flex-grow-1 justify-content-center align-items-center"
    >
      <div class="card w-25">
        <div class="card-body">
          <!-- Titulo, Icone e perfil -->
          <div class="text-center">
            <img
              class="mb-2"
              src="../../account_circle_64dp_1F1F1F_FILL0_wght400_GRAD0_opsz48.png"
              height="64px"
              width="64px"
              alt=""
            />

            <h3>Acesso restrito</h3>
            <p class="fg-secondary fg-60">Faça login para continuar</p>
          </div>
          <!-- Email -->
          <div class="form-field">
            <label for="fieldText" class="form-label">Email address</label>
            <input
              type="email"
              class="form-control"
              id="fieldText"
              placeholder="name@example.com"
            />
            <div class="form-text"></div>
          </div>
          <!-- Password -->
          <label for="inputPassword5" class="form-label">Password</label>
          <input
            type="password"
            id="inputPassword5"
            class="form-control"
            aria-describedby="passwordHelpBlock"
            placeholder="example: 1234#P"
          />
          <div id="passwordHelpBlock" class="form-text"></div>

          <div class="d-grid">
            <a
              class="btn-solid theme-primary"
              href="../Produtos/produtos.html"
              type="button"
            >
              Logar
            </a>
          </div>
        </div>
      </div>
    </main>
    <!-- Pé -->
    <footer></footer>
    <!-- Script -->
    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
